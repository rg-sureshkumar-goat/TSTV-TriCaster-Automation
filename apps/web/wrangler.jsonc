// Cloudflare settings for the TSTV website. Free plan only: Workers, D1 and SQLite Durable Objects.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tstv-show",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Anything that isn't a file is a page of the app.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tstv-show",
      // The free D1 database on the Cloudflare account (created Oct 28, 2026).
      "database_id": "657cf217-8a8e-4e3d-a90e-fd6921aac729",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "EpisodeRoom", "class_name": "EpisodeRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EpisodeRoom"] }],
  "vars": {
    // Only the local .dev.vars file turns this on, and only for localhost.
    "DEV_LOGIN": "false"
  }
}
