    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
