{
  "name": "tstv-show-automation",
  "private": true,
  "type": "module",
  "description": "TSTV Show Automation: rundown, script and prompter website plus the TriCaster show app",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "apps/web",
    "apps/show-app",
    "tools/simulator"
  ],
  "scripts": {
    "probe": "node tools/probe/probe.mjs",
    "simulator": "tsx tools/simulator/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tools/simulator && tsc -p tools/probe && tsc -p packages/shared && tsc -p apps/web && tsc -p apps/web/worker && tsc -p apps/show-app",
    "dev": "npm run dev -w apps/web",
    "test:e2e": "npm run test:e2e -w apps/web",
    "show-app": "npm start -w apps/show-app"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false,
    "core-js": false,
    "electron": true,
    "ffmpeg-static": true
  }
}
